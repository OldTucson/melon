[Unit]
Description=Melon age-gated inspiration concept object cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=melon
Group=melon
EnvironmentFile=/etc/melon/web.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/melon/current
ExecStart=/usr/bin/node --conditions=react-server --import tsx scripts/cleanup-inspiration-concept-objects.ts
TimeoutStartSec=15min
TimeoutStopSec=150s
MemoryMax=512M
TasksMax=128
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
