NODE_ENV=development
DATABASE_URL=postgres://melon:melon@localhost:55432/melon_test
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TRUST_PROXY=false
APP_ORIGIN=http://localhost:3000

SITE_OPERATOR_NAME=
SITE_CONTACT_EMAIL=
SITE_LEGAL_EFFECTIVE_DATE=2026-10-23
ICP_FILING_NUMBER=
PUBLIC_SECURITY_FILING_NUMBER=
PUBLIC_SECURITY_FILING_URL=

ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=replace-with-your-oss-bucket
ALIYUN_OSS_ENDPOINT=https://assets.example.test
ALIYUN_OSS_CNAME=false
ALIYUN_STS_ROLE_ARN=acs:ram::123456789012:role/replace-with-upload-role
OSS_ADAPTER=real

ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Server-only Qwen configuration; required only when inspiration is enabled.
INSPIRATION_ENABLED=false
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_OPENAI_BASE_URL=
DASHSCOPE_NATIVE_BASE_URL=
INSPIRATION_SEARCH_MODEL=qwen-plus
INSPIRATION_STRUCTURE_MODEL=qwen3.8-flash

IMAGE_SEARCH_ENABLED=false
IMAGE_SEARCH_RELEASE_APPROVED=false
IMAGE_SEARCH_SERVICE_URL=http://127.0.0.1:8091
IMAGE_SEARCH_INTERNAL_TOKEN=
IMAGE_SEARCH_ACTIVE_VERSION=visual-search-v2
IMAGE_SEARCH_MODEL_SHA256=

# Python visual-search service. The two internal-token values must be identical.
VISUAL_SEARCH_DATABASE_URL=postgres://melon:melon@localhost:55432/melon_test
VISUAL_SEARCH_OSS_REGION=cn-hangzhou
VISUAL_SEARCH_OSS_BUCKET=replace-with-your-oss-bucket
VISUAL_SEARCH_OSS_ENDPOINT=https://assets.example.test
VISUAL_SEARCH_INTERNAL_TOKEN=
VISUAL_SEARCH_ACTIVE_VERSION=visual-search-v2
VISUAL_SEARCH_MODEL_PATH=/absolute/path/to/dinov2-small.onnx
VISUAL_SEARCH_MODEL_SHA256=
# Optional in development only: previews stay in OSS while feature archives live here.
# VISUAL_SEARCH_FEATURE_STORAGE_DIR=/absolute/path/to/visual-search-features
VISUAL_SEARCH_TEMP_DIR=/tmp/melon-visual-search
VISUAL_SEARCH_MAX_CONCURRENCY=1
VISUAL_SEARCH_ENV=development

# Production Compose inputs; use a registry digest, not a mutable tag.
VISUAL_SEARCH_IMAGE=melon-visual-search:local
VISUAL_SEARCH_MODEL_HOST_PATH=/opt/melon/models/dinov2-small.onnx
VISUAL_SEARCH_TEMP_HOST_PATH=/var/lib/melon/visual-search/tmp
VISUAL_SEARCH_REPORT_HOST_PATH=/var/lib/melon/visual-search/reports
VISUAL_SEARCH_PRODUCTION_DATABASE_NAME=
