{
  "name": "melon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspiration:configure": "node --import tsx scripts/import-inspiration-config.ts",
    "test:inspiration:real": "RUN_REAL_INSPIRATION_TESTS=1 vitest run src/features/inspiration/qwen-provider.real.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:commercial": "E2E_METADATA_ONLY=1 E2E_PORT=${E2E_PORT:-3211} E2E_DATABASE_URL=${E2E_DATABASE_URL:-postgres://melon:melon@127.0.0.1:55432/melon_commercial_e2e} playwright test",
    "seed:performance": "node --conditions=react-server --import tsx scripts/seed-performance.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "user:create": "node --conditions=react-server --import tsx scripts/create-user.ts",
    "user:reset-password": "node --conditions=react-server --import tsx scripts/reset-password.ts",
    "trash:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-trash.ts",
    "preview:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-manual-previews.ts",
    "auth:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-auth-rate-limits.ts",
    "prod:check": "node --conditions=react-server --import tsx scripts/check-production.ts",
    "image-search:backfill": "node --conditions=react-server --import tsx scripts/backfill-image-search.ts"
  },
  "dependencies": {
    "@alicloud/credentials": "^2.4.7",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/sts20150401": "^1.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@inquirer/prompts": "^8.7.3",
    "@next/env": "16.4.1",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "ag-psd": "^31.0.3",
    "ali-oss": "^6.23.0",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-image-crop": "^11.1.2",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/ali-oss": "^6.23.3",
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
